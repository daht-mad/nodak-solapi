# nodak-solapi 환경변수 — 각자 본인 값으로 채워서 쓰세요.
# 이 파일을 복사해서 .env 로 만들거나(스킬 폴더 내), 셸/워크스페이스 .env 에 넣으면 됩니다.
#   cp .env.example .env   그리고 아래 값 채우기

# 솔라피 콘솔 → 개발/연동 → API Key 관리에서 발급
SOLAPI_API_KEY=발급받은_API_KEY
SOLAPI_API_SECRET=발급받은_API_SECRET

# 기본 발신번호 — 솔라피 콘솔에 사전 등록·인증한 "본인" 번호로 바꾸세요.
# (설정 안 하면 발송 시 매번 --from 으로 번호를 줘야 함)
SOLAPI_SENDER=01000000000
